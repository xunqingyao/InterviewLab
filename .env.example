# Copy to .env, then fill in secrets. Never commit .env.
# Local development only: change the database password before public deployment.
POSTGRES_USER=interviewlab
POSTGRES_PASSWORD=interviewlab
POSTGRES_DB=interviewlab
POSTGRES_PORT=5432

APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8000
DATABASE_URL=postgresql+asyncpg://${POSTGRES_USER}:${POSTGRES_PASSWORD}@127.0.0.1:${POSTGRES_PORT}/${POSTGRES_DB}
DOCKER_DATABASE_URL=postgresql+asyncpg://${POSTGRES_USER}:${POSTGRES_PASSWORD}@postgres:5432/${POSTGRES_DB}
INTERVIEWLAB_DEV_AUTH=1
DEV_USER_DISPLAY_NAME=local-dev
# Replace with a random value for deployment; this placeholder is for localhost only.
SESSION_SECRET=change-me-in-any-non-local-env
PUBLIC_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
FILE_ROOT=./data/files
CHECKPOINT_SCHEMA=langgraph
# live = real model; fake = offline simulation. Fill MODEL_API_KEY before starting live.
MODEL_PROVIDER=live
MODEL_API_KEY=
MODEL_API_BASE=https://api.deepseek.com
MODEL_IDENTIFIER=deepseek-flash
MAX_SESSION_COST=5.00
MAX_UPLOAD_BYTES=5242880
GLOBAL_LLM_SLOTS=4
CORS_ENABLED=0

# Default local startup: API runs the worker internally; do not start another worker.
INLINE_WORKER=1
WORKER_ID=worker-local
LEASE_SECONDS=60
HEARTBEAT_SECONDS=10
REPORT_GRACE_SECONDS=60
EVENT_RETENTION=10000

# Vite dev-server configuration only. Never put API keys in VITE_* variables.
WEB_HOST=127.0.0.1
WEB_PORT=5173
WEB_API_TARGET=http://127.0.0.1:${APP_PORT}
